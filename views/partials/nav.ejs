<header class="sticky top-0 z-50 border-b border-gray-100 bg-white/95 shadow-sm backdrop-blur">
  <nav
    class="container mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-3 px-4 py-3 sm:px-6"
    aria-label="Main navigation"
  >
    <a
      href="/"
      class="flex shrink-0 items-center gap-2 rounded-xl px-2 py-1 text-xl font-bold tracking-tight text-red-500 transition hover:text-red-600"
      aria-label="airbnb home"
    >
      <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-red-50">
        <i class="fa-solid fa-house" aria-hidden="true"></i>
      </span>
      <span>airbnb</span>
    </a>

    <ul class="flex flex-wrap items-center justify-end gap-1 text-sm font-medium text-gray-600 sm:gap-2">
      <% if (isLoggedIn) { %>
          <% if (user && user.userType === 'guest') { %>
        <li>
          <a
            href="/homes"
            class="<%= currentPage === 'Home' ? 'bg-red-50 text-red-600' : 'hover:bg-gray-100 hover:text-gray-900' %> inline-flex items-center gap-2 rounded-xl px-3 py-2 transition sm:px-4"
            <%= currentPage === 'Home' ? 'aria-current="page"' : '' %>
          >
            <i class="fa-solid fa-house-chimney" aria-hidden="true"></i>
            <span>Homes</span>
          </a>
        </li>
        <li>
          <a
            href="/favourites"
            class="<%= currentPage === 'favourites' ? 'bg-red-50 text-red-600' : 'hover:bg-gray-100 hover:text-gray-900' %> inline-flex items-center gap-2 rounded-xl px-3 py-2 transition sm:px-4"
            <%= currentPage === 'favourites' ? 'aria-current="page"' : '' %>
          >
            <i class="fa-regular fa-heart" aria-hidden="true"></i>
            <span>Favourites</span>
          </a>
        </li>
        <li>
          <a
            href="/bookings"
            class="<%= currentPage === 'bookings' ? 'bg-red-50 text-red-600' : 'hover:bg-gray-100 hover:text-gray-900' %> inline-flex items-center gap-2 rounded-xl px-3 py-2 transition sm:px-4"
            <%= currentPage === 'bookings' ? 'aria-current="page"' : '' %>
          >
            <i class="fa-regular fa-calendar-check" aria-hidden="true"></i>
            <span>Bookings</span>
          </a>
        </li>
        <% }else { %>
        <li>
          <a
            href="/host/host-home-list"
            class="<%= currentPage === 'host-homes' ? 'bg-red-50 text-red-600' : 'hover:bg-gray-100 hover:text-gray-900' %> inline-flex items-center gap-2 rounded-xl px-3 py-2 transition sm:px-4"
            <%= currentPage === 'host-homes' ? 'aria-current="page"' : '' %>
          >
            <i class="fa-solid fa-key" aria-hidden="true"></i>
            <span>Host homes</span>
          </a>
        </li>
        <li>
          <a
            href="/host/add-home"
            class="<%= currentPage === 'addHome' ? 'bg-red-50 text-red-600' : 'hover:bg-gray-100 hover:text-gray-900' %> inline-flex items-center gap-2 rounded-xl px-3 py-2 transition sm:px-4"
            <%= currentPage === 'addHome' ? 'aria-current="page"' : '' %>
          >
            <i class="fa-solid fa-circle-plus" aria-hidden="true"></i>
            <span>Add home</span>
          </a>
        </li>
        <li>
          <form action="/auth/logout" method="POST">
            <button
              type="submit"
              class="inline-flex items-center gap-2 rounded-xl border border-gray-200 px-3 py-2 text-gray-700 transition hover:border-red-200 hover:bg-red-50 hover:text-red-600 sm:px-4"
            >
              <i class="fa-solid fa-arrow-right-from-bracket" aria-hidden="true"></i>
              <span>Logout</span>
            </button> 
          </form>
        </li>
      <% } } else { %>
        <li>
          <a
            href="/auth/login"
            class="<%= currentPage === 'login' ? 'bg-red-50 text-red-600' : 'hover:bg-gray-100 hover:text-gray-900' %> inline-flex items-center rounded-xl px-3 py-2 transition sm:px-4"
            <%= currentPage === 'login' ? 'aria-current="page"' : '' %>
          >
            Login
          </a>
          </li>

           
        <li>
          <a
            href="/auth/signup"
            class="<%= currentPage === 'signup' ? 'bg-red-600 text-white shadow-sm hover:bg-red-700' : 'bg-red-500 text-white shadow-sm hover:bg-red-600' %> inline-flex items-center gap-2 rounded-xl px-4 py-2 transition"
            <%= currentPage === 'signup' ? 'aria-current="page"' : '' %>
          >
            <i class="fa-solid fa-user-plus" aria-hidden="true"></i>
            <span>Sign up</span>
          </a>
        </li>
      <% } %>
    </ul>
  </nav>
</header>
