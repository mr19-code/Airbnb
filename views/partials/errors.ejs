    <% if (errors.length > 0) { %>
              <div class="col-span-2 rounded-lg bg-red-100 p-4 text-sm text-red-700 mb-4" role="alert">
                <strong class="font-bold">Error!</strong>
                <ul class="mt-2 list-inside list-disc">
                  <% errors.forEach(error => { %>
                    <li><%= error %></li>  
                  <% }); %>
                </ul>
              </div>
              <% } %>