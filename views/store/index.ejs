<%- include('../partials/head') %>
  </head>
  <body>
    <%- include('../partials/nav') %>
    <main class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:py-12">
      <section class="relative mb-10 overflow-hidden rounded-3xl bg-gradient-to-r from-red-500 via-rose-500 to-pink-600 px-6 py-10 text-white shadow-xl shadow-red-200/60 sm:px-10 sm:py-14">
        <div class="absolute -right-16 -top-28 h-80 w-80 rounded-full bg-white/10"></div>
        <div class="relative max-w-2xl">
          <p class="mb-3 text-sm font-semibold uppercase tracking-[0.2em] text-red-100">
            Find your place
          </p>
          <h1 class="text-4xl font-bold leading-tight sm:text-5xl">
            Your next getaway starts here.
          </h1>
          <p class="mt-4 max-w-xl text-base leading-relaxed text-red-50 sm:text-lg">
            Discover welcoming homes, lovely stays, and special places worth exploring.
          </p>
          <a href="/homes" class="mt-7 inline-flex items-center gap-2 rounded-xl bg-white px-5 py-3 font-semibold text-red-600 shadow-sm transition hover:-translate-y-0.5 hover:bg-red-50">
            Explore all homes
            <i class="fa-solid fa-arrow-right text-sm" aria-hidden="true"></i>
          </a>
        </div>
      </section>

      <div class="mb-5 flex items-end justify-between gap-4">
        <div>
          <p class="text-sm font-semibold uppercase tracking-wider text-red-500">Handpicked for you</p>
          <h2 class="mt-1 text-2xl font-bold text-gray-900 sm:text-3xl">Popular stays</h2>
        </div>
        <a href="/homes" class="shrink-0 text-sm font-semibold text-red-600 transition hover:text-red-700">
          See all <span aria-hidden="true">→</span>
        </a>
      </div>
      <% const getHomeImage = (home) => {
           if (!home || !home.photo) return '/images/placeholder.png';
           if (home.photo.startsWith('http')) return home.photo;
           if (home.photo.startsWith('/')) return home.photo;
           return '/images/' + home.photo;
      }; %>
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        <% registeredHomes.forEach(home => { %>
          <article class="group overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-gray-200/70 transition duration-300 hover:-translate-y-1 hover:shadow-xl">
            <a href="/homes/<%= home._id %>" class="relative block overflow-hidden">
              <img src="<%= getHomeImage(home) %>" alt="<%= home.houseName %>" class="h-60 w-full object-cover transition duration-500 group-hover:scale-105" onerror="this.onerror=null;this.src='/images/placeholder.png'">
              <span class="absolute left-3 top-3 rounded-full bg-white/95 px-3 py-1 text-xs font-semibold text-gray-700 shadow-sm">
                <i class="fa-solid fa-sparkles mr-1 text-red-500" aria-hidden="true"></i>Featured stay
              </span>
            </a>
            <div class="p-5">
              <div class="mb-2 flex items-start justify-between gap-3">
                <div>
                  <h3 class="text-lg font-bold text-gray-900"><%= home.houseName %></h3>
                  <p class="mt-1 flex items-center gap-1.5 text-sm text-gray-500">
                    <i class="fa-solid fa-location-dot text-red-400" aria-hidden="true"></i>
                    <%= home.location %>
                  </p>
                </div>
                <div class="flex shrink-0 items-center gap-1 text-sm font-semibold text-gray-700">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4 text-amber-400">
                    <path fill-rule="evenodd" d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.007 5.404.433c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.433 2.082-5.006z" clip-rule="evenodd" />
                  </svg>
                  <span><%= home.rating %></span>
                </div>
              </div>
              <div class="mt-4 flex items-center justify-between border-t border-gray-100 pt-4">
                <p class="text-gray-500">
                  <span class="text-lg font-bold text-gray-900">Rs <%= home.price %></span>
                  <span class="text-sm"> / night</span>
                </p>
                <a href="/homes/<%= home._id %>" class="inline-flex items-center gap-2 rounded-xl bg-red-50 px-4 py-2 text-sm font-semibold text-red-600 transition hover:bg-red-100">
                  View stay <i class="fa-solid fa-arrow-right text-xs" aria-hidden="true"></i>
                </a>
              </div>
            </div>
          </article>
        <% }) %>
      </div>
    </main>
  </body>
</html>
