        <h1 class="mt-1 text-3xl font-bold text-gray-900 sm:text-4xl">My bookings</h1>
      </header>
      <section class="rounded-3xl bg-white px-6 py-16 text-center shadow-sm ring-1 ring-gray-200/70">
