<%- include('../partials/head') %>
  </head>
  <body>
    <%- include('../partials/nav') %>
    <main class="mx-auto max-w-7xl px-4 py-10 sm:px-6">
      <header class="mb-8 flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="text-sm font-semibold uppercase tracking-wider text-red-500">Your hosting dashboard</p>
          <h1 class="mt-1 text-3xl font-bold text-gray-900 sm:text-4xl">Your homes</h1>
          <p class="mt-2 text-gray-500">Manage the places you share with guests.</p>
        </div>
        <a href="/host/add-home" class="inline-flex items-center gap-2 rounded-xl bg-red-500 px-5 py-3 font-semibold text-white shadow-sm transition hover:bg-red-600">
          <i class="fa-solid fa-plus" aria-hidden="true"></i> Add a home
        </a>
      </header>
      <% const getHomeImage = (home) => {
           if (!home || !home.photo) return '/images/placeholder.png';
           if (home.photo.startsWith('http')) return home.photo;
           if (home.photo.startsWith('/')) return home.photo;
           return '/images/' + home.photo;
      }; %>
      <% if (registeredHomes.length === 0) { %>
        <section class="rounded-2xl bg-white px-6 py-16 text-center shadow-sm ring-1 ring-gray-200/70">
          <span class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-2xl bg-red-50 text-xl text-red-500">
            <i class="fa-solid fa-house-circle-check" aria-hidden="true"></i>
          </span>
          <h2 class="text-xl font-bold text-gray-900">Your hosting journey starts here</h2>
          <p class="mt-2 text-gray-500">Add your first home to share it with guests.</p>
          <a href="/host/add-home" class="mt-6 inline-flex rounded-xl bg-red-500 px-5 py-3 font-semibold text-white transition hover:bg-red-600">Add your home</a>
        </section>
      <% } else { %>
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
          <% registeredHomes.forEach(home => { %>
            <article class="group overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-gray-200/70 transition duration-300 hover:-translate-y-1 hover:shadow-xl">
              <img src="<%= getHomeImage(home) %>" alt="<%= home.houseName %>" class="h-60 w-full object-cover transition duration-500 group-hover:scale-105" onerror="this.onerror=null;this.src='/images/placeholder.png'">
              <div class="p-5">
                <h2 class="text-lg font-bold text-gray-900"><%= home.houseName %></h2>
                <p class="mt-1 flex items-center gap-1.5 text-sm text-gray-500">
                  <i class="fa-solid fa-location-dot text-red-400" aria-hidden="true"></i><%= home.location %>
                </p>
                <div class="mt-3 flex items-center justify-between">
                  <span class="font-bold text-gray-900">Rs <%= home.price %> <span class="font-normal text-gray-500">/ night</span></span>
                  <div class="flex items-center gap-1 text-sm font-semibold text-gray-700">
                    <i class="fa-solid fa-star text-amber-400" aria-hidden="true"></i>
                    <span><%= home.rating %></span>
                  </div>
                </div>
                <div class="mt-4 flex gap-2 border-t border-gray-100 pt-4">
                  <a class="flex-1 rounded-xl border border-gray-200 px-4 py-2.5 text-center text-sm font-semibold text-gray-700 transition hover:border-red-200 hover:bg-red-50 hover:text-red-600" href="/host/edit-home/<%= home._id %>?editing=true">
                    <i class="fa-solid fa-pen mr-1" aria-hidden="true"></i> Edit
                  </a>
                  <form action="/host/delete-home/<%= home._id %>" method="POST" class="flex-1">
                    <button type="submit" class="w-full rounded-xl border border-red-100 px-4 py-2.5 text-sm font-semibold text-red-600 transition hover:bg-red-50">
                      <i class="fa-solid fa-trash-can mr-1" aria-hidden="true"></i> Delete
                    </button>
                  </form>
                </div>
              </div>
            </article>
          <% }) %>
        </div>
      <% } %>
    </main>
  </body>
</html>
