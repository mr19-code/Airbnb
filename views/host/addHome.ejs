<%- include('../partials/head') %>
  </head>
  <body>
    <%- include('../partials/nav') %>
    <main class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
      <a href="/host/host-home-list" class="mb-5 inline-flex items-center gap-2 text-sm font-semibold text-gray-500 transition hover:text-red-600">
        <i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Back to your homes
      </a>
      <section class="rounded-3xl bg-white p-6 shadow-sm ring-1 ring-gray-200/70 sm:p-10">
        <header class="mb-8">
          <p class="text-sm font-semibold uppercase tracking-wider text-red-500">Make someone feel at home</p>
          <h1 class="mt-1 text-3xl font-bold text-gray-900">
            <%= editing ? 'Edit your home' : 'List your home' %>
          </h1>
          <p class="mt-2 text-gray-500">Add a few details to help guests discover your place.</p>
        </header>

        <form action="/host/<%= editing ? 'edit-home' : 'add-home' %>" method="POST" class="space-y-5">
          <input type="hidden" name="_id" value="<%= editing ? home._id : '' %>" />

          <div>
            <label for="houseName" class="mb-1.5 block text-sm font-medium text-gray-700">Home name</label>
            <input
              type="text"
              name="houseName"
              id="houseName"
              value="<%= editing ? home.houseName : '' %>"
              placeholder="e.g. Sunny garden cottage"
              class="w-full rounded-xl border border-gray-200 bg-gray-50 px-4 py-3 transition placeholder:text-gray-400 focus:border-red-400 focus:bg-white focus:outline-none focus:ring-4 focus:ring-red-100"
            />
          </div>

          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label for="price" class="mb-1.5 block text-sm font-medium text-gray-700">Price per night (Rs)</label>
              <input
                type="text"
                name="price"
                id="price"
                value="<%= editing ? home.price : '' %>"
                placeholder="e.g. 5000"
                class="w-full rounded-xl border border-gray-200 bg-gray-50 px-4 py-3 transition placeholder:text-gray-400 focus:border-red-400 focus:bg-white focus:outline-none focus:ring-4 focus:ring-red-100"
              />
            </div>
            <div>
              <label for="rating" class="mb-1.5 block text-sm font-medium text-gray-700">Rating</label>
              <input
                type="text"
                name="rating"
                id="rating"
                value="<%= editing ? home.rating : '' %>"
                placeholder="e.g. 4.8"
                class="w-full rounded-xl border border-gray-200 bg-gray-50 px-4 py-3 transition placeholder:text-gray-400 focus:border-red-400 focus:bg-white focus:outline-none focus:ring-4 focus:ring-red-100"
              />
            </div>
          </div>

          <div>
            <label for="location" class="mb-1.5 block text-sm font-medium text-gray-700">Location</label>
            <input
              type="text"
              name="location"
              id="location"
              value="<%= editing ? home.location : '' %>"
              placeholder="City or neighbourhood"
              class="w-full rounded-xl border border-gray-200 bg-gray-50 px-4 py-3 transition placeholder:text-gray-400 focus:border-red-400 focus:bg-white focus:outline-none focus:ring-4 focus:ring-red-100"
            />
          </div>

          <div>
            <label for="photo" class="mb-1.5 block text-sm font-medium text-gray-700">Photo URL</label>
            <input
              type="text"
              name="photo"
              id="photo"
              value="<%= editing ? home.photo : '' %>"
              placeholder="Paste an image URL"
              class="w-full rounded-xl border border-gray-200 bg-gray-50 px-4 py-3 transition placeholder:text-gray-400 focus:border-red-400 focus:bg-white focus:outline-none focus:ring-4 focus:ring-red-100"
            />
          </div>

          <div>
            <label for="description" class="mb-1.5 block text-sm font-medium text-gray-700">Description</label>
            <textarea
              name="description"
              id="description"
              rows="4"
              placeholder="What makes your home special?"
              class="w-full resize-y rounded-xl border border-gray-200 bg-gray-50 px-4 py-3 transition placeholder:text-gray-400 focus:border-red-400 focus:bg-white focus:outline-none focus:ring-4 focus:ring-red-100"
            ><%= editing ? home.description : '' %></textarea>
          </div>

          <button
            type="submit"
            class="w-full rounded-xl bg-red-500 py-3.5 font-semibold text-white shadow-lg shadow-red-500/20 transition hover:-translate-y-0.5 hover:bg-red-600 focus:outline-none focus:ring-4 focus:ring-red-200"
          >
            <%= editing ? 'Save changes' : 'Publish your home' %>
            <i class="fa-solid fa-arrow-right ml-2 text-sm" aria-hidden="true"></i>
          </button>
        </form>
      </section>
    </main>
  </body>
</html>
